# Supabase — Required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Dashboard — Required
# Password to access admin panel after Supabase auth
ADMIN_DASHBOARD_PASSWORD=change-me-in-vercel

# Web3Forms — Optional (email notifications)
# Get key at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-key

# Site — Optional (used in sitemap + OG)
NEXT_PUBLIC_SITE_URL=https://searoadbrokerage.vercel.app
NEXT_PUBLIC_COMPANY_EMAIL=searoadbrokerageinc@gmail.com
NEXT_PUBLIC_COMPANY_PHONE=209-920-0003
